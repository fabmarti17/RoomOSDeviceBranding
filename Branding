// ===================== HELPERS =====================
function formatMS(totalSeconds) {
  const m = Math.floor(totalSeconds / 60);
  const s = totalSeconds % 60;
  return m + ':' + (s < 10 ? '0' + s : s);
}

/* Panel XML is built by string concatenation: user input must be escaped */
function escapeXml(s) {
  return String(s == null ? '' : s)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&apos;');
}

/* Keep the tail of a URL visible: the file name matters more than the host */
function displayValue(v, placeholder = '(not set)') {
  const s = String(v || placeholder);
  return s.length > MAX_VALUE_DISPLAY
    ? '…' + s.substring(s.length - (MAX_VALUE_DISPLAY - 1))
    : s;
}

/* For free text, truncating the END is more natural than the start */
function displayText(v, placeholder = '(empty)') {
  const s = String(v || placeholder);
  return s.length > MAX_VALUE_DISPLAY ? s.substring(0, MAX_VALUE_DISPLAY - 1) + '…' : s;
}

function withTrailingSlash(url) {
  const s = String(url || '').trim();
  if (!s) return '';
  return s.endsWith('/') ? s : s + '/';
}

function pinConfigured() {
  return PIN && PIN !== 'CHANGE_ME';
}

function sanitizeMessage(text) {
  const s = String(text || '').trim();
  return s.length > MAX_MESSAGE_LENGTH ? s.substring(0, MAX_MESSAGE_LENGTH) : s;
}

async function setWidget(id, value) {
  try { await xapi.Command.UserInterface.Extensions.Widget.SetValue({ WidgetId: id, Value: value }); }
  catch (e) { /* panel closed — ignore */ }
}

async function clearWidget(id) {
  try { await xapi.Command.UserInterface.Extensions.Widget.UnsetValue({ WidgetId: id }); }
  catch (e) { /* ignore */ }
}

async function inCall() {
  try {
    const calls = await xapi.Status.SystemUnit.State.NumberOfActiveCalls.get();
    const n = parseInt(calls, 10);
    return !isNaN(n) && n > 0;
  } catch (e) { return false; }
}

/* Panel location depends on whether the button is allowed during calls */
function panelLocation() {
  return SHOW_BUTTON_IN_CALL ? 'HomeScreenAndCallControls' : 'HomeScreen';
}

function activeBase() {
  if (settings.baseUrl) return { url: withTrailingSlash(settings.baseUrl), source: 'panel' };
  if (ASSET_BASE_URL)   return { url: withTrailingSlash(ASSET_BASE_URL),   source: 'constant' };
  if (USE_GITHUB_PAGES) {
    return {
      url: 'https://' + GITHUB_USER + '.github.io/' + GITHUB_REPO + '/' + ASSETS_PATH + '/',
      source: 'github-pages',
    };
  }
  return {
    url: 'https://raw.githubusercontent.com/' + GITHUB_USER + '/' + GITHUB_REPO
       + '/' + GITHUB_BRANCH + '/' + ASSETS_PATH + '/',
    source: 'github-raw',
  };
}

function customerBaseUrl() {
  if (!settings.customer) return '';
  return activeBase().url + settings.customer + '/';
}

function effectiveUrl(field) {
  if (settings[field]) return settings[field];
  const base = customerBaseUrl();
  return base ? base + FILE_NAMES[field] : '';
}

function baseLabel() {
  const b = activeBase();
  if (b.source === 'panel')        return b.url;
  if (b.source === 'constant')     return b.url + ' (default)';
  if (b.source === 'github-pages') return 'GitHub Pages (fallback)';
  return 'GitHub raw (lab fallback)';
}

/* Does our panel currently exist on the device? */
async function panelExists() {
  try {
    const res = await xapi.Command.UserInterface.Extensions.List();
    const panels = res && res.Extensions && res.Extensions.Panel;
    if (!panels) return false;
    const arr = Array.isArray(panels) ? panels : [panels];
    return arr.some(p => {
      const id = p && (p.PanelId && p.PanelId.Value ? p.PanelId.Value : p.PanelId);
      return id === PANEL_ID;
    });
  } catch (e) {
    return false;   // unknown -> let the caller re-save
  }
}

// ===================== WELCOME MESSAGE =====================
async function readLiveMessage() {
  try {
    liveMessage = await xapi.Config.UserInterface.CustomMessage.get();
  } catch (e) {
    liveMessage = '';
    console.log('Could not read CustomMessage: ' + (e.message || e));
  }
  return liveMessage;
}

async function writeMessage(text) {
  const value = sanitizeMessage(text);
  try {
    await xapi.Config.UserInterface.CustomMessage.set(value);
    liveMessage = value;
    console.log('Welcome message set to: ' + (value || '(empty)'));
    return true;
  } catch (e) {
    console.warn('Could not set welcome message: ' + (e.message || e));
    return false;
  }
}

// ===================== SETTINGS PERSISTENCE =====================
function buildDataSource(data) {
  return `import xapi from 'xapi';
// Dormant data container holding the branding settings — DO NOT activate.
const brandingData = ${JSON.stringify(data, null, 2)};
`;
}

async function saveSettings() {
  try {
    await xapi.Command.Macros.Macro.Save(
      { Name: DATA_MACRO, Overwrite: 'True', Transpile: 'False' },
      buildDataSource(settings));
    await xapi.Command.Macros.Macro.Deactivate({ Name: DATA_MACRO });
    console.log('Branding settings saved.');
  } catch (e) {
    console.warn('Could not save branding settings: ' + (e.message || e));
  }
}

async function loadSettings() {
  try {
    const list = await xapi.Command.Macros.Macro.Get({ Name: DATA_MACRO, Content: 'True' });
    const src = list.Macro && list.Macro[0] && list.Macro[0].Content;
    if (!src) return;
    const match = src.match(/const brandingData = ([\s\S]*?);\s*\n/);
    if (!match) return;
    const data = JSON.parse(match[1]);
    settings = {
      baseUrl:   data.baseUrl   || DEFAULTS.baseUrl,
      customer:  data.customer  || DEFAULTS.customer,
      logo:      data.logo      || DEFAULTS.logo,
      halfwake:  data.halfwake  || DEFAULTS.halfwake,
      wallpaper: data.wallpaper || DEFAULTS.wallpaper,
      message:   data.message   || DEFAULTS.message,
      sessionExpiresAt: parseInt(data.sessionExpiresAt, 10) || 0,
    };
    console.log('Branding settings loaded from ' + DATA_MACRO + '.');
  } catch (e) {
    console.log('No stored branding settings — using defaults.');
  }
}

// ===================== ADMIN SESSION =====================
function sessionRemainingSec() {
  if (!adminSessionActive) return 0;
  const ms = adminSessionExpiresAt - Date.now();
  return ms > 0 ? Math.ceil(ms / 1000) : 0;
}

async function updateTimerWidget() {
  const sec = sessionRemainingSec();
  await setWidget(W_TIMER, sec > 0 ? 'Auto-lock in ' + formatMS(sec) : 'Locked');
}

function startCountdown() {
  if (adminCountdownHandle) clearInterval(adminCountdownHandle);
  updateTimerWidget();
  adminCountdownHandle = setInterval(() => {
    if (!adminSessionActive) { stopCountdown(); return; }
    updateTimerWidget();
  }, 1000);
}

function stopCountdown() {
  if (adminCountdownHandle) { clearInterval(adminCountdownHandle); adminCountdownHandle = null; }
}

function scheduleSessionEnd(ms) {
  if (adminSessionHandle) clearTimeout(adminSessionHandle);
  adminSessionHandle = setTimeout(() => { endSession(true); }, ms);
}

/* Open a session. persist=false when restoring after a runtime restart. */
async function startSession(persist = true) {
  adminSessionActive    = true;
  adminSessionExpiresAt = Date.now() + ADMIN_SESSION_MINUTES * 60 * 1000;
  scheduleSessionEnd(ADMIN_SESSION_MINUTES * 60 * 1000);
  startCountdown();
  if (persist) {
    settings.sessionExpiresAt = adminSessionExpiresAt;
    await saveSettings();
  }
  console.log('Branding session opened for ' + ADMIN_SESSION_MINUTES + ' minute(s).');
}

/* Restore a session that was still valid before a runtime restart */
async function restoreSession(remainingMs) {
  adminSessionActive    = true;
  adminSessionExpiresAt = Date.now() + remainingMs;
  scheduleSessionEnd(remainingMs);
  startCountdown();
  console.log('Branding session restored — ' + Math.ceil(remainingMs / 1000) + 's left.');
}

async function endSession(auto = false, notify = true) {
  if (!adminSessionActive) return;
  adminSessionActive    = false;
  adminSessionExpiresAt = 0;
  if (adminSessionHandle) { clearTimeout(adminSessionHandle); adminSessionHandle = null; }
  stopCountdown();
  try { await xapi.Command.UserInterface.Extensions.Panel.Close(); } catch (e) {}
  if (settings.sessionExpiresAt) {
    settings.sessionExpiresAt = 0;
    await saveSettings();
  }
  if (notify) {
    await xapi.Command.UserInterface.Message.Alert.Display({
      Title: 'Branding access locked',
      Text: auto ? 'The session expired.' : 'The session has been closed.',
      Duration: 4,
    });
  }
  console.log('Branding session closed' + (auto ? ' (expired).' : ' (manual).'));
}

