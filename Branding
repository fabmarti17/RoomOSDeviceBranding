/*
 * ============================================================================
 *  Branding — RoomOS branding macro (configurable asset hosting)
 * ============================================================================
 *
 *  WHAT IT DOES
 *  ------------
 *  Adds a PIN-protected "Branding" button letting on-site administrators apply
 *  their own logo, halfwake logo and wallpaper.
 *
 *  Assets are expected to be organised one folder per customer / entity:
 *
 *      <asset base URL>/<customer id>/logo.png
 *      <asset base URL>/<customer id>/halfwake.png
 *      <asset base URL>/<customer id>/wallpaper.jpg
 *
 *  The administrator normally only sets the CUSTOMER ID on the panel — the
 *  macro builds the three URLs automatically. No long URL typing on a tablet.
 *
 *  ASSET HOSTING — RESOLUTION ORDER
 *  --------------------------------
 *  For each asset the URL is resolved in this order, first non-empty wins:
 *
 *    1. Per-asset override   set with the "Edit" button on that row
 *    2. Asset server         set with the "Set" button on the Asset server row
 *    3. ASSET_BASE_URL       constant below (fleet-wide default)
 *    4. GitHub               GITHUB_* constants below (zero-maintenance fallback)
 *
 *  This means the same macro works when assets live on a customer web server,
 *  on a shared internal server, or in a public GitHub repository — and entities
 *  can even use different servers from one another.
 *
 *  HOSTING REQUIREMENTS (any option)
 *  ---------------------------------
 *    - HTTP or HTTPS only: xCommand UserInterface Branding Fetch accepts nothing
 *      else (no SMB, no FTP, no local path, no upload from the panel)
 *    - Reachable WITHOUT authentication: devices send no credentials
 *    - Must return the binary image, not an HTML preview page
 *      -> SharePoint / OneDrive / Google Drive share links do NOT work
 *    - Reachable from the devices (internal network or Internet)
 *
 *  ASSET SPECIFICATIONS
 *  --------------------
 *    logo.png       transparent PNG, ~272x272 px, <= 1 MB
 *    halfwake.png   transparent PNG, ~272x272 px, <= 1 MB
 *    wallpaper.jpg  JPEG/PNG, 3840x2160 px (4K) recommended, <= 16 MB
 *
 *  REQUIREMENTS
 *  ------------
 *    - RoomOS 11 or later, ES modules, Transpile = False
 *    - This macro must stay ACTIVE; BrandingData must stay dormant
 *
 *  PARAMETERS TO REVIEW BEFORE USE
 *  -------------------------------
 *    PIN                MANDATORY — replace 'CHANGE_ME' with your code
 *    ASSET_BASE_URL     fleet-wide asset server, e.g. 'https://assets.acme.com/roomos/'
 *                       leave empty to fall back to GitHub
 *    GITHUB_USER        GitHub account or organisation (fallback only)
 *    GITHUB_REPO        repository holding the assets (fallback only)
 *    GITHUB_BRANCH      usually 'main'
 *    ASSETS_PATH        base folder inside the repo, e.g. 'assets'
 *    USE_GITHUB_PAGES   true to use <user>.github.io/<repo>/... instead of raw
 *    FILE_NAMES         expected file names inside each customer folder
 *    KNOWN_CUSTOMERS    optional shortlist shown as quick-pick buttons
 *    ADMIN_SESSION_MINUTES / REAPPLY_ENABLED / REAPPLY_TIME
 *
 *  IMPORTANT NOTES
 *  ---------------
 *    - Assets are fetched ONLY on an explicit admin action, after confirmation.
 *      Nothing is fetched at init or restart: RoomOS keeps the images locally
 *      once applied, so there is no need to download them again.
 *    - Control Hub supports only ONE global branding per organisation. If a
 *      global branding is pushed there, it will override what this macro
 *      applies. Set REAPPLY_ENABLED to true to reclaim the branding every night.
 *    - The custom welcome message is NOT handled here: it lives in
 *      xConfiguration UserInterface CustomMessage and is covered by the Admin
 *      macro (and by its configuration backups).
 *
 *  FIRST RUN
 *  ---------
 *    1. Set PIN, then ASSET_BASE_URL (or the GITHUB_* constants).
 *    2. Publish the images to <base>/<customer id>/ on that server.
 *    3. On the panel: Branding > set the Customer ID > Apply all.
 *
 * ============================================================================
 */

import xapi from 'xapi';

// ===================== PARAMETERS =====================
const PANEL_ID          = 'branding_panel';
const DATA_MACRO        = 'BrandingData';
const PIN               = 'CHANGE_ME';   // ⚠️ Set your own PIN

// ---- Asset hosting: fleet-wide default (highest priority after panel input) ----
// Point this at any HTTPS server. Trailing slash is optional.
// Leave empty to use the GitHub settings below.
const ASSET_BASE_URL    = '';            // e.g. 'https://assets.acme.com/roomos/'

// ---- GitHub fallback (used only when nothing else is set) ----
const GITHUB_USER       = 'your-github-user';
const GITHUB_REPO       = 'roomos-branding-assets';
const GITHUB_BRANCH     = 'main';
const ASSETS_PATH       = 'assets';
const USE_GITHUB_PAGES  = false;         // true -> https://<user>.github.io/<repo>/...

// Expected file names inside each customer folder
const FILE_NAMES = {
  logo:      'logo.png',
  halfwake:  'halfwake.png',
  wallpaper: 'wallpaper.jpg',
};

// Optional shortlist shown as quick-pick buttons (leave empty to type only)
const KNOWN_CUSTOMERS = [
  'acme-paris',
  'acme-lyon',
  'contoso-hq',
];

// ---- Admin session ----
const ADMIN_SESSION_MINUTES = 10;
let   adminSessionActive    = false;
let   adminSessionHandle    = null;
let   adminSessionExpiresAt = 0;
let   adminCountdownHandle  = null;

// ---- Optional daily re-apply (use if Control Hub overrides local branding) ----
const REAPPLY_ENABLED = false;
const REAPPLY_TIME    = '03:45';   // device local time
let   lastReapplyDay  = null;

// ---- Widgets ----
const W_TIMER        = 'br_timer';
const W_BASE         = 'br_base';
const W_BASE_SET     = 'br_base_set';
const W_CUSTOMER     = 'br_customer';
const W_CUSTOMER_SET = 'br_customer_set';
const W_PICK         = 'br_pick';
const W_APPLY_ALL    = 'br_apply_all';
const W_CLEAR        = 'br_clear';

const VALUE_WIDGETS = {
  logo:      'br_val_logo',
  halfwake:  'br_val_halfwake',
  wallpaper: 'br_val_wallpaper',
};
const EDIT_WIDGETS = {
  br_edit_logo:      'logo',
  br_edit_halfwake:  'halfwake',
  br_edit_wallpaper: 'wallpaper',
};
const APPLY_WIDGETS = {
  br_apply_logo:      'logo',
  br_apply_halfwake:  'halfwake',
  br_apply_wallpaper: 'wallpaper',
};

const FIELD_META = {
  logo:      { label: 'Logo',          type: 'Branding' },
  halfwake:  { label: 'Halfwake logo', type: 'HalfwakeBranding' },
  wallpaper: { label: 'Wallpaper',     type: 'Background' },
};

const PIN_FEEDBACK   = 'br_pin';
const IN_BASE        = 'br_in_base';
const IN_CUSTOMER    = 'br_in_customer';
const IN_PREFIX      = 'br_in_asset_';     // br_in_asset_logo, ...
const APPLY_FEEDBACK = 'br_confirm_apply';
const CLEAR_FEEDBACK = 'br_confirm_clear';

const MAX_VALUE_DISPLAY = 24;

// ---- Persisted settings ----
const DEFAULTS = {
  baseUrl:   '',   // asset server set from the panel (overrides ASSET_BASE_URL)
  customer:  '',   // folder name, e.g. 'acme-paris'
  logo:      '',   // optional full-URL override
  halfwake:  '',
  wallpaper: '',
};
let settings = {
  baseUrl:   DEFAULTS.baseUrl,
  customer:  DEFAULTS.customer,
  logo:      DEFAULTS.logo,
  halfwake:  DEFAULTS.halfwake,
  wallpaper: DEFAULTS.wallpaper,
};

let pendingApplyField = null;   // 'logo' | 'halfwake' | 'wallpaper' | 'all'

// ===================== HELPERS =====================
function formatMS(totalSeconds) {
  const m = Math.floor(totalSeconds / 60);
  const s = totalSeconds % 60;
  return m + ':' + (s < 10 ? '0' + s : s);
}

/* Keep the tail of a URL visible: the file name matters more than the host */
function displayValue(v, placeholder = '(not set)') {
  const s = String(v || placeholder);
  return s.length > MAX_VALUE_DISPLAY ? '…' + s.substring(s.length - (MAX_VALUE_DISPLAY - 1)) : s;
}

function withTrailingSlash(url) {
  const s = String(url || '').trim();
  if (!s) return '';
  return s.endsWith('/') ? s : s + '/';
}

async function setWidget(id, value) {
  try { await xapi.Command.UserInterface.Extensions.Widget.SetValue({ WidgetId: id, Value: value }); }
  catch (e) { /* panel closed — ignore */ }
}

async function clearWidget(id) {
  try { await xapi.Command.UserInterface.Extensions.Widget.UnsetValue({ WidgetId: id }); }
  catch (e) { /* ignore */ }
}

async function inCall() {
  try {
    const calls = await xapi.Status.SystemUnit.State.NumberOfActiveCalls.get();
    const n = parseInt(calls, 10);
    return !isNaN(n) && n > 0;
  } catch (e) { return false; }
}

/* Which asset server is effectively in use, and where it comes from */
function activeBase() {
  if (settings.baseUrl) return { url: withTrailingSlash(settings.baseUrl), source: 'panel' };
  if (ASSET_BASE_URL)   return { url: withTrailingSlash(ASSET_BASE_URL),   source: 'constant' };
  if (USE_GITHUB_PAGES) {
    return {
      url: 'https://' + GITHUB_USER + '.github.io/' + GITHUB_REPO + '/' + ASSETS_PATH + '/',
      source: 'github-pages',
    };
  }
  return {
    url: 'https://raw.githubusercontent.com/' + GITHUB_USER + '/' + GITHUB_REPO
       + '/' + GITHUB_BRANCH + '/' + ASSETS_PATH + '/',
    source: 'github-raw',
  };
}

/* Base URL for the current customer folder */
function customerBaseUrl() {
  if (!settings.customer) return '';
  return activeBase().url + settings.customer + '/';
}

/* Effective URL for one asset: per-asset override wins, otherwise built path */
function effectiveUrl(field) {
  if (settings[field]) return settings[field];
  const base = customerBaseUrl();
  return base ? base + FILE_NAMES[field] : '';
}

/* Label shown on the Asset server row */
function baseLabel() {
  const b = activeBase();
  if (b.source === 'panel')    return b.url;
  if (b.source === 'constant') return b.url + ' (default)';
  return 'GitHub (fallback)';
}

// ===================== SETTINGS PERSISTENCE =====================
function buildDataSource(data) {
  return `import xapi from 'xapi';
// Dormant data container holding the branding settings — DO NOT activate.
const brandingData = ${JSON.stringify(data, null, 2)};
`;
}

async function saveSettings() {
  try {
    await xapi.Command.Macros.Macro.Save(
      { Name: DATA_MACRO, Overwrite: 'True', Transpile: 'False' },
      buildDataSource(settings));
    await xapi.Command.Macros.Macro.Deactivate({ Name: DATA_MACRO });
    console.log('Branding settings saved.');
  } catch (e) {
    console.warn('Could not save branding settings: ' + (e.message || e));
  }
}

async function loadSettings() {
  try {
    const list = await xapi.Command.Macros.Macro.Get({ Name: DATA_MACRO, Content: 'True' });
    const src = list.Macro && list.Macro[0] && list.Macro[0].Content;
    if (!src) return;
    const match = src.match(/const brandingData = ([\s\S]*?);\n/);
    if (!match) return;
    const data = JSON.parse(match[1]);
    settings = {
      baseUrl:   data.baseUrl   || DEFAULTS.baseUrl,
      customer:  data.customer  || DEFAULTS.customer,
      logo:      data.logo      || DEFAULTS.logo,
      halfwake:  data.halfwake  || DEFAULTS.halfwake,
      wallpaper: data.wallpaper || DEFAULTS.wallpaper,
    };
    console.log('Branding settings loaded from ' + DATA_MACRO + '.');
  } catch (e) {
    console.log('No stored branding settings — using defaults.');
  }
}

// ===================== ADMIN SESSION =====================
function sessionRemainingSec() {
  if (!adminSessionActive) return 0;
  const ms = adminSessionExpiresAt - Date.now();
  return ms > 0 ? Math.ceil(ms / 1000) : 0;
}

async function updateTimerWidget() {
  const sec = sessionRemainingSec();
  await setWidget(W_TIMER, sec > 0 ? 'Auto-lock in ' + formatMS(sec) : 'Locked');
}

function startCountdown() {
  if (adminCountdownHandle) clearInterval(adminCountdownHandle);
  updateTimerWidget();
  adminCountdownHandle = setInterval(() => {
    if (!adminSessionActive) { stopCountdown(); return; }
    updateTimerWidget();
  }, 1000);
}

function stopCountdown() {
  if (adminCountdownHandle) { clearInterval(adminCountdownHandle); adminCountdownHandle = null; }
}

function startSession() {
  adminSessionActive = true;
  adminSessionExpiresAt = Date.now() + ADMIN_SESSION_MINUTES * 60 * 1000;
  if (adminSessionHandle) clearTimeout(adminSessionHandle);
  adminSessionHandle = setTimeout(() => { endSession(true); }, ADMIN_SESSION_MINUTES * 60 * 1000);
  startCountdown();
  console.log('Branding session opened for ' + ADMIN_SESSION_MINUTES + ' minute(s).');
}

async function endSession(auto = false, notify = true) {
  if (!adminSessionActive) return;
  adminSessionActive = false;
  adminSessionExpiresAt = 0;
  if (adminSessionHandle) { clearTimeout(adminSessionHandle); adminSessionHandle = null; }
  stopCountdown();
  try { await xapi.Command.UserInterface.Extensions.Panel.Close(); } catch (e) {}
  if (notify) {
    await xapi.Command.UserInterface.Message.Alert.Display({
      Title: 'Branding access locked',
      Text: auto ? 'The session expired.' : 'The session has been closed.',
      Duration: 4,
    });
  }
  console.log('Branding session closed' + (auto ? ' (expired).' : ' (manual).'));
}

// ===================== PANEL =====================
function assetRowXml(field, label) {
  return `
          <Row>
            <Name>${label}</Name>
            <Widget>
              <WidgetId>${VALUE_WIDGETS[field]}</WidgetId>
              <Type>Text</Type>
              <Name>${displayValue(effectiveUrl(field))}</Name>
              <Options>size=2;fontSize=small;align=left</Options>
            </Widget>
            <Widget>
              <WidgetId>br_edit_${field}</WidgetId>
              <Type>Button</Type>
              <Name>Edit</Name>
              <Options>size=1</Options>
            </Widget>
            <Widget>
              <WidgetId>br_apply_${field}</WidgetId>
              <Type>Button</Type>
              <Name>Apply</Name>
              <Options>size=1</Options>
            </Widget>
          </Row>`;
}

function pickRowXml() {
  if (!KNOWN_CUSTOMERS.length) return '';
  const values = KNOWN_CUSTOMERS
    .map(c => `<Value><Key>${c}</Key><Name>${c}</Name></Value>`).join('');
  return `
          <Row>
            <Name>Quick pick</Name>
            <Widget>
              <WidgetId>${W_PICK}</WidgetId>
              <Type>GroupButton</Type>
              <Options>size=4;columns=1</Options>
              <ValueSpace>${values}</ValueSpace>
            </Widget>
          </Row>`;
}

function panelXml() {
  return `
    <Extensions>
      <Version>1.11</Version>
      <Panel>
        <Order>2</Order>
        <PanelId>${PANEL_ID}</PanelId>
