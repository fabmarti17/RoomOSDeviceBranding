// ===================== BRANDING ACTIONS =====================
async function fetchSafe(field) {
  const type = FIELD_META[field].type;
  const url  = effectiveUrl(field);
  if (!url) {
    console.warn('No URL for ' + type + ' (customer ID not set), skipping');
    return false;
  }
  try {
    await xapi.Command.UserInterface.Branding.Fetch({ Type: type, URL: url });
    console.log('Fetched ' + type + ' from ' + url);
    if (field === 'wallpaper' && SET_WALLPAPER_AUTO) {
      // Best effort: some builds need the wallpaper mode aligned to show it.
      try { await xapi.Config.UserInterface.Wallpaper.set('Auto'); }
      catch (e) { console.log('Wallpaper config not set (ignored): ' + (e.message || e)); }
    }
    return true;
  } catch (e) {
    console.warn('Fetch failed for ' + type + ' (' + url + '): ' + (e.message || e));
    return false;
  }
}

async function applyField(field, silent = false) {
  const ok = await fetchSafe(field);
  if (!silent) {
    await xapi.Command.UserInterface.Message.Alert.Display({
      Title: 'Branding',
      Text: FIELD_META[field].label + (ok ? ' applied' : ' failed — check logs'),
      Duration: 5,
    });
  }
  return ok;
}

/* Apply the three images, then re-apply the staged welcome message if any */
async function applyAll(silent = false) {
  const results = [];
  for (const field of ['logo', 'halfwake', 'wallpaper']) {
    results.push(await fetchSafe(field));
  }
  const ok = results.filter(Boolean).length;

  let msgNote = '';
  if (settings.message) {
    const done = await writeMessage(settings.message);
    msgNote = done ? ', message set' : ', message failed';
  }

  if (!silent) {
    await xapi.Command.UserInterface.Message.Alert.Display({
      Title: 'Branding',
      Text: ok + ' of 3 images applied' + msgNote + ' (check logs)',
      Duration: 5,
    });
  }
  return ok;
}

/* Clear one asset — falls back to Branding Delete when Clear is not
   implemented on this build ("Method not found"). */
async function clearAsset(type) {
  try {
    await xapi.Command.UserInterface.Branding.Clear({ Type: type });
    return true;
  } catch (e1) {
    try {
      await xapi.Command.UserInterface.Branding.Delete({ Type: type });
      return true;
    } catch (e2) {
      console.warn('Could not clear ' + type + ': ' + (e1.message || e1)
                 + ' / ' + (e2.message || e2));
      return false;
    }
  }
}

async function clearBranding() {
  let ok = 0;
  for (const field of ['logo', 'halfwake', 'wallpaper']) {
    if (await clearAsset(FIELD_META[field].type)) ok += 1;
  }
  let msgNote = '';
  if (CLEAR_MESSAGE_WITH_BRANDING) {
    const done = await writeMessage('');
    if (done) {
      settings.message = '';
      await saveSettings();
      msgNote = ', message cleared';
    }
  }
  await xapi.Command.UserInterface.Message.Alert.Display({
    Title: 'Branding',
    Text: ok + ' of 3 images removed' + msgNote,
    Duration: 5,
  });
}

// ===================== REMOTE APPLY =====================
/* Triggered by activating the dormant BrandingApply macro.
   No confirmation prompt: the caller already has admin access.
   Branding deactivates BrandingApply itself, AFTER the fetches, so the
   runtime is never restarted in the middle of an apply. */
async function handleRemoteApply() {
  const now = Date.now();
  if (now - lastRemoteSignalAt < 5000) return;   // de-duplicate double listeners
  lastRemoteSignalAt = now;

  console.log('--- REMOTE BRANDING APPLY TRIGGERED ---');
  try {
    if (!settings.customer && !settings.logo && !settings.halfwake
        && !settings.wallpaper && !settings.message) {
      console.warn('Remote branding apply: nothing configured.');
      return;
    }
    const ok = await applyAll(true);
    console.log('Remote branding apply: ' + ok + ' of 3 images applied.');
  } finally {
    // Re-arm the trigger for next time (may restart the macro runtime — safe here)
    try { await xapi.Command.Macros.Macro.Deactivate({ Name: APPLY_MACRO }); }
    catch (e) { /* already dormant */ }
  }
}

// ===================== EVENTS =====================
xapi.Event.UserInterface.Extensions.Panel.Clicked.on(async event => {
  if (event.PanelId !== PANEL_ID) return;
  if (!SHOW_BUTTON_IN_CALL && (await inCall())) return;
  if (!adminSessionActive) {
    await xapi.Command.UserInterface.Extensions.Panel.Close();
    await askPin();
  } else {
    await openPanel();
  }
});

xapi.Event.UserInterface.Message.TextInput.Response.on(async event => {
  const fid = event.FeedbackId || '';

  // ---- PIN ----
  if (fid === PIN_FEEDBACK) {
    if (pinConfigured() && event.Text === PIN) {
      await startSession();
      await openPanel();
    } else {
      await xapi.Command.UserInterface.Message.Alert.Display({
        Title: 'Access denied', Text: 'Wrong PIN', Duration: 4 });
    }
    return;
  }

  // ---- Asset server base URL ----
  if (fid === IN_BASE) {
    settings.baseUrl = (event.Text || '').trim();
    await saveSettings();
    console.log('Asset server set to: ' + (settings.baseUrl || '(default)'));
    await backToPanel();
    await xapi.Command.UserInterface.Message.Alert.Display({
      Title: 'Saved',
      Text: settings.baseUrl ? 'Asset server updated' : 'Asset server reset to default',
      Duration: 4,
    });
    return;
  }

  // ---- Customer ID (empty input keeps the current value) ----
  if (fid === IN_CUSTOMER) {
    const entered = (event.Text || '').trim();
    if (!entered) {
      console.log('Customer ID unchanged (empty input ignored).');
      await backToPanel();
      return;
    }
    settings.customer = entered;
    await saveSettings();
    console.log('Customer ID set to: ' + settings.customer);
    await backToPanel();
    await xapi.Command.UserInterface.Message.Alert.Display({
      Title: 'Saved', Text: 'Customer ID updated — press Apply all to load the assets', Duration: 4,
    });
    return;
  }

  // ---- Welcome message (applied immediately) ----
  if (fid === IN_MESSAGE) {
    const value = sanitizeMessage(event.Text);
    const truncated = String(event.Text || '').trim().length > MAX_MESSAGE_LENGTH;
    const ok = await writeMessage(value);
    if (ok) {
      settings.message = value;
      await saveSettings();
    }
    await backToPanel();
    await xapi.Command.UserInterface.Message.Alert.Display({
      Title: ok ? 'Welcome message' : 'Error',
      Text: ok
        ? (value ? 'Message applied' + (truncated ? ' (truncated to ' + MAX_MESSAGE_LENGTH + ' chars)' : '')
                 : 'Message cleared')
        : 'Could not set the message — check logs',
      Duration: 4,
    });
    return;
  }

  // ---- Per-asset URL override ----
  if (fid.startsWith(IN_PREFIX)) {
    const field = fid.substring(IN_PREFIX.length);
    if (FIELD_META[field]) {
      settings[field] = (event.Text || '').trim();
      await saveSettings();
      console.log('Override for ' + field + ': ' + (settings[field] || '(cleared)'));
      await backToPanel();
      await xapi.Command.UserInterface.Message.Alert.Display({
        Title: 'Saved', Text: field + ' URL updated — press Apply to load it', Duration: 3,
      });
    }
    return;
  }
});

xapi.Event.UserInterface.Message.TextInput.Clear.on(async event => {
  const fid = event.FeedbackId || '';
  if (fid === PIN_FEEDBACK) { console.log('PIN entry cancelled.'); return; }
  if (fid === IN_BASE || fid === IN_CUSTOMER || fid === IN_MESSAGE
      || fid.startsWith(IN_PREFIX)) {
    console.log('Edit cancelled.');
    await backToPanel();
  }
});

xapi.Event.UserInterface.Message.Prompt.Response.on(async event => {
  if (event.FeedbackId === APPLY_FEEDBACK) {
    const field = pendingApplyField;
    pendingApplyField = null;
    if (event.OptionId === '1' && field) {
      if (field === 'all') await applyAll();
      else await applyField(field);
    } else {
      console.log('Branding apply cancelled.');
    }
    await backToPanel();
    return;
  }
  if (event.FeedbackId === CLEAR_FEEDBACK) {
    if (event.OptionId === '1') await clearBranding();
    else console.log('Branding removal cancelled.');
    await backToPanel();
    return;
  }
  if (event.FeedbackId === MSG_CLEAR_FEEDBACK) {
    if (event.OptionId === '1') {
      const ok = await writeMessage('');
      if (ok) { settings.message = ''; await saveSettings(); }
      await xapi.Command.UserInterface.Message.Alert.Display({
        Title: 'Welcome message',
        Text: ok ? 'Message cleared' : 'Could not clear the message',
        Duration: 4,
      });
    } else {
      console.log('Message clear cancelled.');
    }
    await backToPanel();
    return;
  }
});

xapi.Event.UserInterface.Extensions.Widget.Action.on(async event => {
  const id   = event.WidgetId;
  const val  = event.Value;
  const type = event.Type;

  // ---- Quick pick list ----
  if (id === W_PICK && (type === 'released' || type === 'clicked')) {
    settings.customer = val;
    await saveSettings();
    console.log('Customer ID set from quick pick: ' + val);
    await refreshValues();
    await xapi.Command.UserInterface.Message.Alert.Display({
      Title: 'Customer selected', Text: val + ' — press Apply all to load the assets', Duration: 4,
    });
    return;
  }

  if (type !== 'clicked') return;

  if (id === W_BASE_SET) {
    await xapi.Command.UserInterface.Extensions.Panel.Close();
    await askBaseUrl();
    return;
  }

  if (id === W_CUSTOMER_SET) {
    await xapi.Command.UserInterface.Extensions.Panel.Close();
    await askCustomerId();
    return;
  }

  if (id === W_MSG_EDIT) {
    await xapi.Command.UserInterface.Extensions.Panel.Close();
    await askMessage();
    return;
  }

  if (id === W_MSG_CLEAR) {
    await xapi.Command.UserInterface.Extensions.Panel.Close();
    await confirmMessageClear();
    return;
  }

  if (EDIT_WIDGETS[id]) {
    await xapi.Command.UserInterface.Extensions.Panel.Close();
    await askUrlOverride(EDIT_WIDGETS[id]);
    return;
  }

  if (APPLY_WIDGETS[id]) {
    await xapi.Command.UserInterface.Extensions.Panel.Close();
    await confirmApply(APPLY_WIDGETS[id]);
    return;
  }

  if (id === W_APPLY_ALL) {
    await xapi.Command.UserInterface.Extensions.Panel.Close();
    await confirmApply('all');
    return;
  }

  if (id === W_CLEAR) {
    await xapi.Command.UserInterface.Extensions.Panel.Close();
    await confirmClear();
    return;
  }
});

/* Remote signal — register both known event paths, whichever exists on
   this build. handleRemoteApply() de-duplicates if both fire. */
try {
  xapi.Event.Message.Send.on(event => {
    const text = event && (event.Text && event.Text.Value ? event.Text.Value : event.Text);
    if (text === REMOTE_APPLY_SIGNAL) handleRemoteApply();
  });
} catch (e) { console.log('Message.Send listener unavailable: ' + (e.message || e)); }

try {
  xapi.Event.Message.Send.Text.on(text => {
    if (text === REMOTE_APPLY_SIGNAL) handleRemoteApply();
  });
} catch (e) { console.log('Message.Send.Text listener unavailable: ' + (e.message || e)); }

/* Call state: adjust visibility, and optionally close the session */
xapi.Status.SystemUnit.State.NumberOfActiveCalls.on(async (calls) => {
  await updateButtonVisibility();
  const active = parseInt(calls, 10) > 0;
  if (active && !SHOW_BUTTON_IN_CALL) {
    try { await xapi.Command.UserInterface.Extensions.Panel.Close(); } catch (e) {}
  }
  if (active && !KEEP_SESSION_IN_CALL) {
    await endSession(false, false);
  }
});

/* Self-healing: re-create the button only if it disappeared */
setInterval(() => { updateButtonVisibility(); }, HEAL_INTERVAL_MS);

// ===================== INIT =====================
(async () => {
  try {
    await loadSettings();
    await readLiveMessage();

    // Restore an admin session that survived a macro runtime restart
    const remaining = (settings.sessionExpiresAt || 0) - Date.now();
    if (remaining > 5000) {
      await restoreSession(remaining);
    } else if (settings.sessionExpiresAt) {
      settings.sessionExpiresAt = 0;
      await saveSettings();
    }

    if (SHOW_BUTTON_IN_CALL || !(await inCall())) await showButton();

    if (!pinConfigured()) {
      console.warn('Branding: PIN is still CHANGE_ME — the panel will stay locked.');
    }
    console.log('Branding macro initialized — nothing applied automatically.'
              + ' Button in call: ' + SHOW_BUTTON_IN_CALL + '.');
  } catch (e) {
    console.error('Init failed: ' + (e.message || e));
  }
})();
