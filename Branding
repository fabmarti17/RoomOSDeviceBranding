async function showButton() {
  await readLiveMessage();   // keep the displayed message in sync
  await xapi.Command.UserInterface.Extensions.Panel.Save({ PanelId: PANEL_ID }, panelXml());
}

async function hideButton() {
  try { await xapi.Command.UserInterface.Extensions.Panel.Remove({ PanelId: PANEL_ID }); } catch (e) {}
}

/* Called on call-state changes and by the self-healing timer.
   Only re-saves the panel when it is actually missing, so an open
   panel is never overwritten. */
async function updateButtonVisibility() {
  if (!SHOW_BUTTON_IN_CALL && (await inCall())) {
    await hideButton();
    return;
  }
  if (!(await panelExists())) {
    await showButton();
    console.log('Branding button restored.');
  }
}

async function refreshValues() {
  await setWidget(W_BASE, displayValue(baseLabel(), 'GitHub (fallback)'));
  await setWidget(W_CUSTOMER, settings.customer || '(not set)');
  for (const field of Object.keys(VALUE_WIDGETS)) {
    await setWidget(VALUE_WIDGETS[field], displayValue(effectiveUrl(field)));
  }
  await readLiveMessage();
  await setWidget(W_MSG, displayText(liveMessage));
}

async function openPanel() {
  await showButton();   // rebuild so labels / quick-pick / message stay in sync
  await xapi.Command.UserInterface.Extensions.Panel.Open({ PanelId: PANEL_ID });
  await clearWidget(W_PICK);
  await updateTimerWidget();
  await refreshValues();
}

async function backToPanel() {
  if (adminSessionActive) await openPanel();
}

