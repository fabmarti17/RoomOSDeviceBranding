(async () => {
  try {
    await loadSettings();          // restore asset server, customer ID and overrides
    await updateButtonVisibility();
    console.log('Branding macro initialized — nothing fetched automatically.');
  } catch (e) {
    console.error('Init failed: ' + (e.message || e));
  }
})();
