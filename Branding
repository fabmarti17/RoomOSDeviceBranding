async function showButton() {
  await xapi.Command.UserInterface.Extensions.Panel.Save({ PanelId: PANEL_ID }, panelXml());
}
async function hideButton() {
  try { await xapi.Command.UserInterface.Extensions.Panel.Remove({ PanelId: PANEL_ID }); } catch (e) {}
}
async function updateButtonVisibility() {
  if (await inCall()) await hideButton(); else await showButton();
}

async function refreshValues() {
  await setWidget(W_BASE, displayValue(baseLabel(), 'GitHub (fallback)'));
  await setWidget(W_CUSTOMER, settings.customer || '(not set)');
  for (const field of Object.keys(VALUE_WIDGETS)) {
    await setWidget(VALUE_WIDGETS[field], displayValue(effectiveUrl(field)));
  }
}

async function openPanel() {
  // Rebuild so labels and the quick-pick list stay in sync
  await showButton();
  await xapi.Command.UserInterface.Extensions.Panel.Open({ PanelId: PANEL_ID });
  await clearWidget(W_PICK);
  await updateTimerWidget();
  await refreshValues();
}

async function backToPanel() {
  if (adminSessionActive) await openPanel();
}

// ===================== INPUT PROMPTS =====================
async function askPin() {
  await xapi.Command.UserInterface.Message.TextInput.Display({
    FeedbackId: PIN_FEEDBACK,
    Title: 'Branding',
    Text: 'Enter the administrator code. Access stays unlocked for ' + ADMIN_SESSION_MINUTES + ' minutes.',
    InputType: 'PIN', KeyboardState: 'Open', SubmitText: 'Submit',
  });
}

async function askBaseUrl() {
  await xapi.Command.UserInterface.Message.TextInput.Display({
    FeedbackId: IN_BASE,
    Title: 'Asset server URL',
    Text: 'Base URL holding the customer folders. Leave empty to use the default. Current: ' + baseLabel(),
    InputType: 'SingleLine',
    Placeholder: settings.baseUrl || 'https://assets.example.com/roomos/',
    SubmitText: 'Save',
    KeyboardState: 'Open',
  });
}

async function askCustomerId() {
  await xapi.Command.UserInterface.Message.TextInput.Display({
    FeedbackId: IN_CUSTOMER,
    Title: 'Customer ID',
    Text: 'Folder name on the asset server. Current: ' + (settings.customer || '(not set)'),
    InputType: 'SingleLine',
    Placeholder: settings.customer || 'acme-paris',
    SubmitText: 'Save',
    KeyboardState: 'Open',
  });
}

async function askUrlOverride(field) {
  const current = settings[field];
  await xapi.Command.UserInterface.Message.TextInput.Display({
    FeedbackId: IN_PREFIX + field,
    Title: FIELD_META[field].label + ' URL override',
    Text: 'Leave empty to use the customer folder. Current: ' + (current || '(none)'),
    InputType: 'SingleLine',
    Placeholder: current || effectiveUrl(field),
    SubmitText: 'Save',
    KeyboardState: 'Open',
  });
}

async function confirmApply(field) {
  pendingApplyField = field;
  const isAll = field === 'all';
  const label = isAll ? 'all three assets' : FIELD_META[field].label.toLowerCase();
  await xapi.Command.UserInterface.Message.Prompt.Display({
    Title: 'Apply branding',
    Text: 'This will download and apply ' + label + ' now. Continue?',
    FeedbackId: APPLY_FEEDBACK,
    'Option.1': 'Yes, apply now',
    'Option.2': 'Cancel',
  });
}

async function confirmClear() {
  await xapi.Command.UserInterface.Message.Prompt.Display({
    Title: 'Remove branding',
    Text: 'Remove the logo, halfwake logo and wallpaper from this device?',
    FeedbackId: CLEAR_FEEDBACK,
    'Option.1': 'Yes, remove',
    'Option.2': 'Cancel',
  });
}

// ===================== BRANDING ACTIONS =====================
/* Fetch a single asset — never throws */
async function fetchSafe(field) {
  const type = FIELD_META[field].type;
  const url  = effectiveUrl(field);
  if (!url) {
    console.warn('No URL for ' + type + ' (customer ID not set), skipping');
    return false;
  }
  try {
    await xapi.Command.UserInterface.Branding.Fetch({ Type: type, URL: url });
    console.log('Fetched ' + type + ' from ' + url);
    return true;
  } catch (e) {
    console.warn('Fetch failed for ' + type + ' (' + url + '): ' + (e.message || e));
    return false;
  }
}

async function applyField(field) {
  const ok = await fetchSafe(field);
  await xapi.Command.UserInterface.Message.Alert.Display({
    Title: 'Branding',
    Text: FIELD_META[field].label + (ok ? ' applied' : ' failed — check logs'),
    Duration: 5,
  });
}

async function applyAll() {
  const results = [];
  for (const field of ['logo', 'halfwake', 'wallpaper']) {
    results.push(await fetchSafe(field));
  }
  const ok = results.filter(Boolean).length;
  await xapi.Command.UserInterface.Message.Alert.Display({
    Title: 'Branding',
    Text: ok + ' of 3 assets applied (check logs)',
    Duration: 5,
  });
}

async function clearBranding() {
  let ok = 0;
  for (const field of ['logo', 'halfwake', 'wallpaper']) {
    try {
      await xapi.Command.UserInterface.Branding.Clear({ Type: FIELD_META[field].type });
      ok += 1;
    } catch (e) {
      console.warn('Could not clear ' + FIELD_META[field].type + ': ' + (e.message || e));
    }
  }
  await xapi.Command.UserInterface.Message.Alert.Display({
    Title: 'Branding',
    Text: ok + ' of 3 assets removed',
    Duration: 5,
  });
}

// ===================== SCHEDULED RE-APPLY =====================
function checkScheduled() {
  updateButtonVisibility();   // self-healing visibility

  if (!REAPPLY_ENABLED) return;
  const now = new Date();
  const p = n => String(n).padStart(2, '0');
  const current = p(now.getHours()) + ':' + p(now.getMinutes());
  const today = now.toDateString();
  if (current === REAPPLY_TIME && lastReapplyDay !== today) {
    lastReapplyDay = today;
    console.log('--- DAILY BRANDING RE-APPLY ---');
    applyAll();
  }
}

// ===================== EVENTS =====================
xapi.Event.UserInterface.Extensions.Panel.Clicked.on(async event => {
  if (event.PanelId !== PANEL_ID) return;
  if (await inCall()) return;
  if (!adminSessionActive) {
    await xapi.Command.UserInterface.Extensions.Panel.Close();
    await askPin();
  } else {
    await openPanel();
  }
});

xapi.Event.UserInterface.Message.TextInput.Response.on(async event => {
  const fid = event.FeedbackId || '';

  // ---- PIN ----
  if (fid === PIN_FEEDBACK) {
    if (event.Text === PIN) {
      startSession();
      await openPanel();
    } else {
      await xapi.Command.UserInterface.Message.Alert.Display({ Title: 'Access denied', Text: 'Wrong PIN', Duration: 4 });
    }
    return;
  }

  // ---- Asset server base URL ----
  if (fid === IN_BASE) {
    settings.baseUrl = (event.Text || '').trim();
    await saveSettings();
    console.log('Asset server set to: ' + (settings.baseUrl || '(default)'));
    await backToPanel();
    await xapi.Command.UserInterface.Message.Alert.Display({
      Title: 'Saved',
      Text: settings.baseUrl ? 'Asset server updated' : 'Asset server reset to default',
      Duration: 4,
    });
    return;
  }

  // ---- Customer ID ----
  if (fid === IN_CUSTOMER) {
    settings.customer = (event.Text || '').trim();
    await saveSettings();
    console.log('Customer ID set to: ' + settings.customer);
    await backToPanel();
    await xapi.Command.UserInterface.Message.Alert.Display({
      Title: 'Saved', Text: 'Customer ID updated — press Apply all to load the assets', Duration: 4,
    });
    return;
  }

  // ---- Per-asset URL override ----
  if (fid.startsWith(IN_PREFIX)) {
    const field = fid.substring(IN_PREFIX.length);
    if (FIELD_META[field]) {
      settings[field] = (event.Text || '').trim();
      await saveSettings();
      console.log('Override for ' + field + ': ' + (settings[field] || '(cleared)'));
      await backToPanel();
      await xapi.Command.UserInterface.Message.Alert.Display({
        Title: 'Saved', Text: field + ' URL updated — press Apply to load it', Duration: 3,
      });
    }
    return;
  }
});

xapi.Event.UserInterface.Message.TextInput.Clear.on(async event => {
  const fid = event.FeedbackId || '';
  if (fid === PIN_FEEDBACK) { console.log('PIN entry cancelled.'); return; }
  if (fid === IN_BASE || fid === IN_CUSTOMER || fid.startsWith(IN_PREFIX)) {
    console.log('Edit cancelled.');
    await backToPanel();
  }
});

xapi.Event.UserInterface.Message.Prompt.Response.on(async event => {
  if (event.FeedbackId === APPLY_FEEDBACK) {
    const field = pendingApplyField;
    pendingApplyField = null;
    if (event.OptionId === '1' && field) {
      if (field === 'all') await applyAll();
      else await applyField(field);
    } else {
      console.log('Branding apply cancelled.');
    }
    await backToPanel();
    return;
  }
  if (event.FeedbackId === CLEAR_FEEDBACK) {
    if (event.OptionId === '1') await clearBranding();
    else console.log('Branding removal cancelled.');
    await backToPanel();
    return;
  }
});

xapi.Event.UserInterface.Extensions.Widget.Action.on(async event => {
  const id = event.WidgetId;
  const val = event.Value;
  const type = event.Type;

  // ---- Quick pick list ----
  if (id === W_PICK && (type === 'released' || type === 'clicked')) {
    settings.customer = val;
    await saveSettings();
    console.log('Customer ID set from quick pick: ' + val);
    await refreshValues();
    await xapi.Command.UserInterface.Message.Alert.Display({
      Title: 'Customer selected', Text: val + ' — press Apply all to load the assets', Duration: 4,
    });
    return;
  }

  if (type !== 'clicked') return;

  if (id === W_BASE_SET) {
    await xapi.Command.UserInterface.Extensions.Panel.Close();
    await askBaseUrl();
    return;
  }

  if (id === W_CUSTOMER_SET) {
    await xapi.Command.UserInterface.Extensions.Panel.Close();
    await askCustomerId();
    return;
  }

  if (EDIT_WIDGETS[id]) {
    await xapi.Command.UserInterface.Extensions.Panel.Close();
    await askUrlOverride(EDIT_WIDGETS[id]);
    return;
  }

  if (APPLY_WIDGETS[id]) {
    await xapi.Command.UserInterface.Extensions.Panel.Close();
    await confirmApply(APPLY_WIDGETS[id]);
    return;
  }

  if (id === W_APPLY_ALL) {
    await xapi.Command.UserInterface.Extensions.Panel.Close();
    await confirmApply('all');
    return;
  }

  if (id === W_CLEAR) {
    await xapi.Command.UserInterface.Extensions.Panel.Close();
    await confirmClear();
    return;
  }
});

// Call state: hide the button and close the session during calls
xapi.Status.SystemUnit.State.NumberOfActiveCalls.on(async (calls) => {
  await updateButtonVisibility();
  if (parseInt(calls, 10) > 0) {
    try { await xapi.Command.UserInterface.Extensions.Panel.Close(); } catch (e) {}
    await endSession(false, false);
  }
});

xapi.Event.Time.on(() => checkScheduled());

